# syntax=docker/dockerfile:1

# --- Build: compiles the backend modules. The Angular UI has its own image (Dockerfile-ui),
# so the build-mvn profile leaves out modules/cpt-ui.
FROM maven:3.9-eclipse-temurin-21 AS build
WORKDIR /build
COPY pom.xml .
COPY modules modules
RUN --mount=type=cache,target=/root/.m2 \
    mvn -B -Pbuild-mvn -DskipTests package

# --- Run
FROM eclipse-temurin:21-jre-alpine
WORKDIR /app
RUN addgroup -S cpt && adduser -S cpt -G cpt
COPY --from=build /build/modules/cpt-web-app/target/cpt-web-app-*.jar app.jar
USER cpt

# In-memory database with seeded test data; data is lost on restart (persistent Postgres: #18).
ENV SPRING_PROFILES_ACTIVE=HSQLDB
EXPOSE 8080
ENTRYPOINT ["java", "-jar", "app.jar"]
