# Template for .env.azure, which scripts/azure-setup.sh writes (the real file is git-ignored).
# You don't need to fill this in by hand: run ./scripts/azure-setup.sh and it creates .env.azure.
# Deployment itself uses the GitHub secrets/variables, not this file.

# From `az account show` (also GitHub secrets)
AZURE_SUBSCRIPTION_ID=00000000-0000-0000-0000-000000000000
AZURE_TENANT_ID=00000000-0000-0000-0000-000000000000

# appId of the cpt-github-deployer app registration (also a GitHub secret)
AZURE_CLIENT_ID=00000000-0000-0000-0000-000000000000

# Region and names (also GitHub variables)
AZURE_LOCATION=centralindia
AZURE_RESOURCE_GROUP=cpt-demo-rg
AZURE_CONTAINERAPPS_ENV=cpt-env
AZURE_BACKEND_APP=cpt-web-app
AZURE_UI_APP=cpt-ui
